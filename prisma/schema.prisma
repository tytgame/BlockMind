datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==================== NextAuth.js Models ====================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // BlockMind
  chatSessions  ChatSession[]
  blocks        Block[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== BlockMind Models ====================

// 사용자의 채팅 세션. 메시지 기록을 보관한다.
model ChatSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 첫 메시지로 자동 생성 (최대 40자)
  title     String?

  // 고정 기능
  isPinned  Boolean   @default(false)
  pinnedAt  DateTime?

  messages  Message[]
  blocks    Block[]   // sourceSessionId로 연결된 자동 추출 블록

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([userId, isPinned])
}

// 채팅 메시지. role은 'user' | 'assistant'
model Message {
  id        String   @id @default(cuid())
  role      String
  content   String   @db.Text
  // AI SDK가 클라이언트에서 생성한 메시지 UUID (user 메시지만 저장)
  // 세션 복원 시 useChat에 주입할 ID로 사용 → messageFilesMap 키 일치에 필요
  clientId  String?
  // 첨부 파일 메타데이터 [{ fileName, fileType, storagePath }] — user 메시지만 저장
  files     Json?

  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([sessionId, createdAt])
}

// 유저 레벨 컨텍스트 블록. 모든 채팅 세션에서 공유된다.
// type: 'data' | 'image' | 'file'
model Block {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String  @default("data")
  label     String
  content   String  @db.Text
  color     String?
  order     Int     @default(0)
  isVisible Boolean @default(true)

  // 파일 첨부 (image / file 타입에서 사용)
  fileUrl         String?   // Supabase Storage path (예: userId/timestamp-name.jpg)
  fileName        String?
  fileType        String?   // MIME type (예: image/jpeg, application/pdf)
  fileSize        Int?      // bytes

  // Gemini Files API (PDF 타입만 사용, 48시간 유효)
  geminiFileUri   String?
  geminiExpiresAt DateTime?

  // 어느 채팅 세션에서 자동 추출되었는지 (null이면 출처 불명)
  sourceSessionId String?
  sourceSession   ChatSession? @relation(fields: [sourceSessionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, order])
  @@index([sourceSessionId])
}
